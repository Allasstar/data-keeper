:root {
    --forge-bg: rgb(26, 27, 30);
    --forge-panel: rgb(38, 40, 44);
    --forge-panel-raised: rgb(46, 48, 53);
    --forge-border: rgb(14, 15, 17);
    --forge-text: rgb(214, 216, 220);
    --forge-text-dim: rgb(132, 136, 143);
    --forge-accent: rgb(255, 146, 48);
    --forge-accent-text: rgb(28, 20, 10);
    --forge-mute: rgb(70, 140, 255);
    --forge-solo: rgb(240, 200, 60);
    --forge-lock: rgb(230, 90, 90);
}

.forge-root {
    flex-grow: 1;
    background-color: var(--forge-bg);
    color: var(--forge-text);
}

.forge-bar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 4px 6px;
    background-color: var(--forge-panel);
    border-bottom-width: 1px;
    border-bottom-color: var(--forge-border);
}

.forge-spacer {
    flex-grow: 1;
}

.forge-recipe-field {
    flex-grow: 1;
    flex-shrink: 1;
    max-width: 300px;
    min-width: 110px;
}

.forge-button {
    min-width: 56px;
    height: 22px;
    border-radius: 3px;
}

.forge-primary {
    background-color: var(--forge-accent);
    color: var(--forge-accent-text);
    -unity-font-style: bold;
}

.forge-primary:hover {
    background-color: rgb(255, 170, 90);
}

.forge-button.forge-button--pill {
    height: 20px;
    padding: 0 10px;
    border-width: 1px;
    border-color: var(--forge-border);
    border-radius: 10px;
    background-color: rgb(20, 21, 24);
    color: var(--forge-text-dim);
    font-size: 11px;
}

.forge-button.forge-button--pill:hover {
    border-color: var(--forge-text-dim);
    color: var(--forge-text);
}

.forge-button.forge-button--pill:active {
    background-color: var(--forge-panel-raised);
}

.forge-button.forge-button--pill-accent {
    border-color: var(--forge-accent);
    color: var(--forge-accent);
}

.forge-button.forge-button--pill-accent:hover {
    background-color: var(--forge-accent);
    color: var(--forge-accent-text);
}

.forge-placeholder {
    flex-grow: 1;
    -unity-text-align: middle-center;
    color: var(--forge-text-dim);
}

.forge-separator {
    width: 1px;
    height: 18px;
    margin: 0 4px;
    background-color: var(--forge-border);
}

.forge-main {
    flex-grow: 1;
    flex-direction: row;
}

.forge-column {
    flex-shrink: 0;
}

.forge-center {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 360px;
}

.forge-left {
    width: 240px;
    padding: 6px;
    background-color: var(--forge-panel);
    border-color: var(--forge-border);
    border-right-width: 1px;
}

.forge-section-title {
    margin: 4px 0 4px 0;
    -unity-font-style: bold;
    font-size: 11px;
    color: var(--forge-accent);
}

.forge-subtitle {
    margin: 6px 0 2px 0;
    font-size: 10px;
    color: var(--forge-text-dim);
}

/* ── Pages ────────────────────────────────────────────────────────────── */

.forge-page-bar {
    padding: 0 6px;
}

.forge-left-toggle {
    min-width: 22px;
    width: 22px;
    height: 20px;
    margin: 0 6px 0 0;
    padding: 0;
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--forge-text-dim);
}

.forge-left-toggle:hover {
    color: var(--forge-accent);
}

.forge-page-tab {
    min-width: 64px;
    height: 24px;
    margin: 0 2px 0 0;
    padding: 0 10px;
    border-width: 0 0 2px 0;
    border-radius: 0;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    color: var(--forge-text-dim);
    -unity-font-style: bold;
}

.forge-page-tab:hover {
    color: var(--forge-text);
}

.forge-page-tab--selected {
    color: var(--forge-accent);
    border-color: var(--forge-accent);
}

.forge-page {
    flex-grow: 1;
}

.forge-page--scroll .unity-scroll-view__content-container {
    padding: 4px 8px 8px 8px;
}

/* ── Pills, variations ────────────────────────────────────────────────── */

.forge-generate {
    flex-direction: row;
    margin-bottom: 4px;
}

.forge-generate > .forge-button {
    flex-grow: 1;
    flex-basis: 0;
    height: 24px;
    margin: 0 2px 0 0;
}

.forge-pills {
    flex-direction: row;
    flex-wrap: wrap;
}

.forge-pill {
    min-width: 0;
    height: 20px;
    margin: 2px;
    padding: 0 8px;
    border-radius: 10px;
    font-size: 10px;
    background-color: var(--forge-panel-raised);
}

.forge-selected {
    background-color: var(--forge-accent);
    color: var(--forge-accent-text);
    -unity-font-style: bold;
}

.forge-randomizer-knobs {
    flex-direction: row;
    justify-content: space-around;
    margin-top: 8px;
}

.forge-candidates {
    margin: 6px 0 10px 0;
}

.forge-candidates > Label {
    min-width: 72px;
}

.forge-variation-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.forge-thumb {
    width: 48%;
    height: 44px;
    margin-bottom: 4px;
    border-width: 1px;
    border-color: var(--forge-border);
    border-radius: 3px;
    background-color: rgb(16, 17, 19);
}

.forge-thumb:hover {
    border-color: var(--forge-text-dim);
}

.forge-thumb--selected {
    border-color: var(--forge-accent);
    border-width: 2px;
}

.forge-thumb--empty {
    opacity: 0.35;
}

.forge-thumb > .forge-waveform {
    flex-grow: 1;
    height: auto;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.forge-thumb__label {
    position: absolute;
    left: 3px;
    top: 1px;
    font-size: 9px;
    color: var(--forge-text-dim);
}

.forge-seed > Label {
    min-width: 36px;
}

.forge-globals .forge-field {
    min-width: 180px;
    margin-right: 8px;
}

.forge-globals .forge-field > Label {
    min-width: 60px;
}

.forge-piano {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 180px;
    max-width: 460px;
    height: 28px;
    margin: 0 6px 0 10px;
    border-width: 1px;
    border-color: var(--forge-border);
    background-color: var(--forge-border);
}

.forge-root-note {
    min-width: 30px;
    -unity-font-style: bold;
    color: var(--forge-accent);
}

/* ── Waveform ─────────────────────────────────────────────────────────── */

.forge-wave-panel {
    flex-shrink: 0;
    padding: 6px;
    background-color: var(--forge-bg);
}

.forge-waveform {
    height: 130px;
    background-color: rgb(16, 17, 19);
    border-width: 1px;
    border-color: var(--forge-border);
    border-radius: 3px;
    --wave-color: rgb(255, 146, 48);
    --wave-center-color: rgba(255, 255, 255, 0.10);
    --playhead-color: rgb(240, 240, 240);
    --trim-color: rgb(90, 190, 255);
    --trim-shade-color: rgba(0, 0, 0, 0.55);
}

.forge-readout {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 4px;
    font-size: 11px;
}

.forge-readout__item {
    flex-direction: row;
    margin-right: 14px;
}

.forge-readout__name {
    margin-right: 4px;
    color: var(--forge-text-dim);
}

.forge-readout__value {
    color: var(--forge-text);
}

.forge-readout__warning {
    color: var(--forge-lock);
    -unity-font-style: bold;
}

/* ── Curve editor ─────────────────────────────────────────────────────── */

.forge-curve-panel {
    flex-shrink: 0;
    padding: 0 6px 6px 6px;
}

.forge-curve-bar {
    flex-wrap: wrap;
    padding: 2px 0;
    background-color: rgba(0, 0, 0, 0);
    border-bottom-width: 0;
}

.forge-tab {
    min-width: 48px;
    height: 20px;
    margin: 0 1px;
    border-radius: 3px 3px 0 0;
    background-color: var(--forge-panel-raised);
}

.forge-tab.forge-selected {
    background-color: var(--forge-accent);
}

.forge-curve-layer {
    margin-left: 8px;
    font-size: 11px;
    color: var(--forge-text-dim);
}

.forge-curve-toggle {
    height: 20px;
    margin-left: 2px;
    padding: 0 6px;
    border-radius: 3px;
    border-width: 1px;
    border-color: var(--forge-border);
    background-color: var(--forge-panel-raised);
}

.forge-curve-toggle:checked {
    background-color: var(--forge-accent);
    color: var(--forge-accent-text);
}

.forge-curve-editor {
    height: 150px;
    background-color: rgb(16, 17, 19);
    border-width: 1px;
    border-color: var(--forge-border);
    border-radius: 3px;
    --curve-color: rgb(255, 146, 48);
    --curve-fill-color: rgba(255, 146, 48, 0.12);
    --grid-color: rgba(255, 255, 255, 0.06);
    --grid-zero-color: rgba(255, 255, 255, 0.18);
    --point-color: rgb(236, 236, 240);
    --point-selected-color: rgb(255, 146, 48);
    --stroke-color: rgb(90, 190, 255);
}

.forge-curve-editor:focus {
    border-color: var(--forge-text-dim);
}

.forge-curve-editor--locked {
    border-color: var(--forge-lock);
    --curve-color: rgb(200, 120, 120);
}

.forge-curve-editor__readout {
    position: absolute;
    right: 6px;
    top: 3px;
    font-size: 10px;
    color: var(--forge-text);
}

/* ── Knobs ────────────────────────────────────────────────────────────── */

.forge-knob {
    align-items: center;
    width: 62px;
    margin: 0 2px;
    --knob-track-color: rgb(16, 17, 19);
    --knob-value-color: rgb(255, 146, 48);
    --knob-body-color: rgb(58, 61, 67);
    --knob-indicator-color: rgb(236, 236, 240);
}

.forge-knob__title {
    font-size: 10px;
    color: var(--forge-text-dim);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.forge-knob__dial {
    width: 38px;
    height: 38px;
    cursor: resize-vertical;
}

.forge-knob__value {
    font-size: 10px;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.forge-knob--locked {
    --knob-value-color: rgb(140, 140, 148);
}

.forge-knob--locked > .forge-knob__title {
    color: var(--forge-lock);
}

.forge-knob:disabled {
    opacity: 0.4;
}

/* Doubled class so it beats context widths like .forge-mod-panel .forge-knob. */
.forge-knob.forge-knob--inline {
    flex-direction: row;
    flex-shrink: 0;
    width: auto;
}

.forge-knob--inline > .forge-knob__dial {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    margin: 0 4px;
}

/* ── Layer strips ─────────────────────────────────────────────────────── */

.forge-layers {
    flex-grow: 1;
    padding: 0 6px;
}

.forge-strip {
    flex-direction: row;
    margin-bottom: 6px;
    background-color: var(--forge-panel);
    border-width: 1px;
    border-color: var(--forge-border);
    border-radius: 4px;
    overflow: hidden;
}

.forge-strip--selected {
    border-color: var(--forge-text-dim);
    background-color: var(--forge-panel-raised);
}

.forge-strip--muted > .forge-strip__body,
.forge-strip--disabled > .forge-strip__body {
    opacity: 0.45;
}

.forge-strip__tab {
    width: 24px;
    flex-shrink: 0;
    align-items: center;
    padding-top: 7px;
    background-color: var(--forge-panel-raised);
    border-right-width: 1px;
    border-right-color: var(--forge-border);
    border-left-width: 3px;
    border-left-color: var(--forge-text-dim);
}

.forge-strip--band-sub > .forge-strip__tab { border-left-color: rgb(130, 90, 210); }
.forge-strip--band-body > .forge-strip__tab { border-left-color: rgb(80, 150, 220); }
.forge-strip--band-click > .forge-strip__tab { border-left-color: rgb(70, 190, 130); }
.forge-strip--band-air > .forge-strip__tab { border-left-color: rgb(210, 180, 70); }

.forge-strip--locked > .forge-strip__tab {
    background-color: rgb(92, 42, 42);
}

.forge-strip__enabled,
.forge-power {
    margin: 0;
}

.forge-strip__enabled > .unity-toggle__input > .unity-toggle__checkmark,
.forge-power > .unity-toggle__input > .unity-toggle__checkmark {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--forge-border);
    background-image: none;
    background-color: rgb(20, 21, 24);
}

.forge-strip__enabled:checked > .unity-toggle__input > .unity-toggle__checkmark,
.forge-power:checked > .unity-toggle__input > .unity-toggle__checkmark {
    background-color: var(--forge-accent);
}

.forge-strip__index {
    margin-top: 6px;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--forge-text-dim);
}

.forge-strip--selected .forge-strip__index {
    color: var(--forge-accent);
}

.forge-strip__index.forge-strip__index--curve-locked {
    color: var(--forge-lock);
}

.forge-strip__body {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    padding: 4px 6px 6px 6px;
}

.forge-strip__head {
    flex-direction: row;
    align-items: center;
}

.forge-strip__name {
    flex-grow: 1;
    min-width: 60px;
    margin: 0 4px 0 0;
}

.forge-strip__name > .unity-base-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-font-style: bold;
}

.forge-strip__name:hover > .unity-base-field__input,
.forge-strip__name:focus > .unity-base-field__input {
    background-color: rgb(20, 21, 24);
}

.forge-strip__band {
    width: 72px;
    margin: 0;
}

.forge-strip__band > .unity-base-field__input {
    padding: 0 6px 0 9px;
    border-radius: 9px;
    -unity-font-style: bold;
}

.forge-strip__band .unity-enum-field__text {
    flex-grow: 1;
    margin: 0;
    padding: 0;
}

.forge-strip__band .unity-enum-field__arrow {
    width: 8px;
    margin: 0 0 0 2px;
}

.forge-strip__band--sub > .unity-base-field__input { background-color: rgb(92, 60, 150); }
.forge-strip__band--body > .unity-base-field__input { background-color: rgb(60, 110, 160); }
.forge-strip__band--click > .unity-base-field__input { background-color: rgb(50, 140, 100); }
.forge-strip__band--air > .unity-base-field__input { background-color: rgb(150, 130, 50); }

.forge-strip__flag {
    width: 22px;
    min-width: 22px;
    height: 20px;
    margin-left: 2px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    border-radius: 3px;
    border-width: 1px;
    border-color: var(--forge-border);
    background-color: var(--forge-panel-raised);
}

.forge-strip__flag--mute:checked { background-color: var(--forge-mute); }
.forge-strip__flag--solo:checked { background-color: var(--forge-solo); color: rgb(30, 25, 5); }

.forge-strip__flag--reverse,
.forge-strip__flag--random {
    width: 36px;
    margin: 0;
}

.forge-strip__flag--reverse:checked,
.forge-strip__flag--random:checked {
    background-color: var(--forge-accent);
    color: var(--forge-accent-text);
}

.forge-strip__menu {
    width: 22px;
    min-width: 22px;
    height: 20px;
    margin: 0 0 0 2px;
    padding: 0;
    border-radius: 3px;
    -unity-font-style: bold;
}

.forge-strip__main {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
}

.forge-strip__display {
    flex-grow: 1;
    flex-basis: 176px;
    min-width: 176px;
    margin: 8px 4px 0 0;
}

.forge-strip__source {
    flex-direction: row;
    align-items: center;
}

.forge-strip__stepper--source-type {
    width: 96px;
    flex-shrink: 0;
}

.forge-strip__stepper--variant,
.forge-strip__clip {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 76px;
    margin: 0 0 0 4px;
}

.forge-strip__views {
    flex-direction: row;
    height: 52px;
    margin-top: 4px;
}

.forge-strip__views > .forge-scope {
    width: 64px;
    flex-shrink: 0;
    margin-right: 4px;
    background-color: rgb(16, 17, 19);
    border-width: 1px;
    border-color: var(--forge-border);
    border-radius: 3px;
    --trace-color: rgb(255, 146, 48);
    --wave-center-color: rgba(255, 255, 255, 0.10);
}

.forge-strip__views > .forge-waveform {
    flex-grow: 1;
    height: auto;
    --wave-color: rgba(255, 146, 48, 0.8);
}

.forge-strip--compact .forge-box {
    display: none;
}

.forge-strip--compact .forge-strip__views {
    height: 30px;
}

.forge-strip__group {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
}

.forge-strip__options {
    align-items: center;
    margin: 0 2px;
}

.forge-strip__knob {
    width: 50px;
    margin: 0 1px;
}

.forge-strip__knob > .forge-knob__dial {
    width: 30px;
    height: 30px;
}

.forge-strip__controls {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 1;
    max-width: 100%;
    align-items: stretch;
}

.forge-strip__stepper--filter,
.forge-strip__stepper--warp {
    margin: 0 2px 2px 2px;
}

/* One knob is narrower than the stepper needs. */
.forge-strip__stepper--warp {
    min-width: 76px;
}

.forge-strip__knob-row {
    flex-direction: row;
    justify-content: center;
}

.forge-strip__stepper--interp {
    width: 84px;
    margin-top: 3px;
}

.forge-strip__field--locked Label,
.forge-strip__field--locked TextElement {
    color: var(--forge-lock);
}

.forge-strip__field--locked.forge-stepper,
.forge-strip__field--locked > .unity-base-field__input,
.forge-strip__field--locked.forge-strip__flag {
    border-color: var(--forge-lock);
}

/* ── Param boxes ──────────────────────────────────────────────────────── */

.forge-box {
    justify-content: center;
    margin: 8px 4px 0 0;
    padding: 9px 3px 2px 3px;
    background-color: rgb(32, 34, 38);
    border-width: 1px;
    border-color: var(--forge-border);
    border-radius: 4px;
}

.forge-box__header {
    position: absolute;
    top: -8px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
}

.forge-box__pill {
    flex-direction: row;
    align-items: center;
    height: 14px;
    padding: 0 8px;
    background-color: var(--forge-panel-raised);
    border-width: 1px;
    border-color: var(--forge-border);
    border-radius: 7px;
}

.forge-box__pill--power {
    height: 16px;
    padding-left: 2px;
    border-radius: 8px;
}

.forge-box__title {
    margin: 0;
    padding: 0;
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    color: var(--forge-text-dim);
}

.forge-box__pill--power > .forge-box__title {
    padding-left: 4px;
}

.forge-box__pill--power > .forge-box__title:hover {
    color: var(--forge-text);
}

.forge-box__content {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
}

.forge-box--stacked > .forge-box__content {
    flex-direction: column;
    flex-wrap: nowrap;
    align-items: stretch;
}

/* ── Stepper ──────────────────────────────────────────────────────────── */

.forge-stepper {
    flex-direction: row;
    align-items: center;
    height: 20px;
    background-color: rgb(20, 21, 24);
    border-width: 1px;
    border-color: var(--forge-border);
    border-radius: 10px;
}

.forge-stepper:hover {
    border-color: var(--forge-text-dim);
}

.forge-stepper__arrow {
    width: 18px;
    min-width: 18px;
    height: 18px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 9px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--forge-text-dim);
    -unity-font-style: bold;
}

.forge-stepper__arrow:hover {
    color: var(--forge-text);
    background-color: var(--forge-panel-raised);
}

.forge-stepper__label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 18px;
    margin: 0;
    padding: 0 2px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    font-size: 11px;
    -unity-text-align: middle-center;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.forge-stepper__field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
}

.forge-stepper__field > .unity-base-field__input {
    padding: 0 2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.forge-stepper__field .unity-base-popup-field__arrow,
.forge-stepper__field .unity-enum-field__arrow {
    display: none;
}

.forge-stepper__field .unity-base-popup-field__text,
.forge-stepper__field .unity-enum-field__text {
    flex-grow: 1;
    font-size: 11px;
    -unity-text-align: middle-center;
}

/* ── FX page ──────────────────────────────────────────────────────────── */

.forge-left__scroll {
    flex-grow: 1;
}

.forge-locked-title {
    color: var(--forge-lock);
}

.forge-fx {
    flex-direction: row;
    max-width: 720px;
    margin: 10px 0 2px 0;
    padding: 12px 6px 6px 6px;
}

.forge-fx > .forge-box__content {
    flex-grow: 1;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: flex-start;
}

.forge-fx--off {
    min-height: 14px;
    padding: 6px 0 0 0;
}

.forge-fx--off > .forge-box__content {
    display: none;
}

/* Left-aligned so the title sits over the graph and doesn't jump when the module collapses. */
.forge-fx > .forge-box__header {
    justify-content: flex-start;
    left: 8px;
}

.forge-fx-graph {
    width: 160px;
    height: 60px;
    flex-shrink: 0;
    margin-right: 8px;
    background-color: rgb(16, 17, 19);
    border-width: 1px;
    border-color: var(--forge-border);
    border-radius: 3px;
    --trace-color: rgb(255, 146, 48);
    --fill-color: rgba(255, 146, 48, 0.18);
    --reference-color: rgba(255, 255, 255, 0.28);
    --marker-color: rgb(230, 90, 90);
    --grid-color: rgba(255, 255, 255, 0.08);
}

.forge-fx__controls {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.forge-fx__mode {
    width: 108px;
    margin: 0 6px 0 0;
}

.forge-knob--small {
    width: 52px;
}

.forge-knob--small > .forge-knob__dial {
    width: 30px;
    height: 30px;
}

/* ── Export page ──────────────────────────────────────────────────────── */

.forge-export {
    max-width: 440px;
}

.forge-export__row {
    flex-direction: row;
    align-items: center;
}

.forge-export__field {
    margin: 1px 0;
}

.forge-export__field > Label {
    min-width: 72px;
    width: 72px;
    margin-right: 4px;
    color: var(--forge-text-dim);
}

.forge-export__field > .unity-base-field__input {
    flex-grow: 1;
    min-width: 0;
}

.forge-export__folder {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 2px;
}

.forge-export__button {
    height: 24px;
    margin: 6px 0 2px 0;
}

.forge-button--icon {
    min-width: 22px;
    width: 22px;
    padding: 0;
}

/* ── Status bar ───────────────────────────────────────────────────────── */

.forge-status {
    flex-direction: row;
    flex-shrink: 0;
    height: 20px;
    align-items: center;
    padding: 0 8px;
    background-color: var(--forge-border);
}

.forge-status__name {
    flex-shrink: 0;
    margin: 0 8px 0 0;
    padding: 0;
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--forge-accent);
}

.forge-status__text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    font-size: 11px;
    color: var(--forge-text-dim);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* ── Top bar: category, presets, icons, meter ─────────────────────────── */

.forge-category {
    width: 104px;
    flex-shrink: 0;
    margin-right: 4px;
}

.forge-preset {
    width: 160px;
    flex-shrink: 0;
}

.forge-preset__name {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 18px;
    margin: 0;
    padding: 0 2px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    font-size: 11px;
    -unity-text-align: middle-center;
    overflow: hidden;
}

.forge-preset__name:hover {
    background-color: rgba(0, 0, 0, 0);
    color: var(--forge-accent);
}

.forge-top-bar .forge-button {
    flex-shrink: 0;
}

.forge-top-bar .forge-button--icon {
    margin: 0 1px;
}

.forge-icon {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    --icon-color: var(--forge-text);
}

.forge-primary .forge-icon,
.forge-icon-toggle:checked .forge-icon {
    --icon-color: var(--forge-accent-text);
}

.forge-icon-toggle {
    width: 22px;
    min-width: 22px;
    height: 22px;
    margin: 0 1px;
    padding: 0;
}

.forge-meter {
    width: 130px;
    flex-shrink: 0;
    height: 16px;
    margin: 0 6px;
    cursor: resize-horizontal;
    --meter-track-color: rgb(16, 17, 19);
    --meter-level-color: rgb(90, 200, 120);
    --meter-warn-color: rgb(240, 200, 60);
    --meter-clip-color: rgb(230, 90, 90);
    --meter-volume-color: rgba(236, 236, 240, 0.7);
}

.forge-meter:hover {
    --meter-volume-color: rgb(255, 146, 48);
}

/* ── Mod page ─────────────────────────────────────────────────────────── */

.forge-mod-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: stretch;
    margin-bottom: 10px;
}

.forge-mod-row .forge-knob {
    width: 58px;
}

/* Tabs on the left, the selected source's panel beside them; 7 tabs set the panel height,
   so the routes below don't jump when switching tabs. */
.forge-mod-sources {
    flex-direction: row;
    align-items: stretch;
    max-width: 640px;
    margin-bottom: 10px;
}

.forge-mod-tabs {
    width: 60px;
    flex-shrink: 0;
    margin: 8px 4px 0 0;
}

.forge-mod-tab {
    min-width: 0;
    height: 20px;
    margin: 0 0 2px 0;
    padding: 0 0 0 6px;
    border-width: 0 0 0 3px;
    border-radius: 2px;
    background-color: var(--forge-panel-raised);
    color: var(--forge-text-dim);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.forge-mod-tab:hover {
    color: var(--forge-text);
}

.forge-mod-tab--selected {
    background-color: rgb(62, 65, 72);
    color: var(--forge-accent);
}

.forge-mod-panels {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.forge-mod-panel {
    flex-grow: 1;
    min-height: 154px;
    margin: 8px 0 0 0;
    padding: 12px 6px 6px 6px;
}

.forge-mod-panel > .forge-box__header {
    justify-content: flex-start;
    left: 8px;
}

.forge-mod-panel > .forge-box__content {
    flex-grow: 1;
    flex-wrap: nowrap;
    justify-content: flex-start;
}

.forge-mod-panel.forge-box--stacked > .forge-box__content {
    align-items: stretch;
}

.forge-mod-panel .forge-knob {
    width: 58px;
}

.forge-mod-panel__graph {
    width: auto;
    min-width: 120px;
    height: 84px;
    flex-grow: 1;
    flex-shrink: 1;
    --marker-color: rgba(236, 236, 240, 0.7);
}

.forge-mod-panel__steppers {
    width: 110px;
    flex-shrink: 0;
    margin-right: 4px;
}

.forge-mod-panel__steppers > .forge-stepper {
    margin: 2px 0;
}

.forge-mod-panel__text {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 8px 0 2px;
    white-space: normal;
    font-size: 11px;
    color: var(--forge-text-dim);
}

.forge-mod-panel__bar {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    margin-bottom: 4px;
}

.forge-mod-panel__curve {
    height: 108px;
    flex-grow: 1;
}

.forge-mod-panel__bar--rnd {
    justify-content: flex-start;
    min-height: 34px;
}

.forge-mod-panel__mode {
    width: 132px;
    flex-shrink: 0;
    margin-right: 8px;
}

.forge-mod-panel__spacer {
    flex-grow: 1;
}

.forge-mod-panel__seed {
    width: 130px;
    flex-shrink: 1;
    margin: 0 4px 0 8px;
}

.forge-mod-panel.forge-box--stacked .forge-mod-panel__graph {
    height: auto;
    min-height: 84px;
}

.forge-mod-panel.forge-box--stacked .forge-mod-panel__text {
    margin-top: 8px;
}

.forge-routes-header,
.forge-routes {
    max-width: 640px;
}

.forge-routes-header .forge-button {
    margin: 0 0 0 4px;
}

.forge-route {
    flex-direction: row;
    align-items: center;
    height: 24px;
    padding: 0 4px 0 0;
    margin-bottom: 2px;
    border-radius: 3px;
    background-color: var(--forge-panel-raised);
    overflow: hidden;
}

.forge-route--off {
    opacity: 0.5;
}

.forge-route--unsupported {
    opacity: 0.4;
}

.forge-route__swatch {
    width: 3px;
    align-self: stretch;
    margin-right: 6px;
}

.forge-route .forge-power {
    margin-right: 6px;
}

.forge-route__source,
.forge-route__target {
    width: 104px;
    flex-shrink: 0;
}

/* Fits the longest target names ("Transient Attack", "Compressor Depth"). */
.forge-route__target {
    width: 140px;
}

.forge-route__arrow {
    margin: 0 4px;
    color: var(--forge-text-dim);
}

.forge-route__layer {
    width: 100px;
    flex-shrink: 0;
    margin-left: 6px;
}

.forge-route__layer-name {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 18px;
    margin: 0;
    padding: 0 2px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    font-size: 11px;
    -unity-text-align: middle-center;
}

.forge-route__amount {
    flex-grow: 1;
    min-width: 110px;
    margin: 0 6px;
}

.forge-route__remove {
    width: 18px;
    min-width: 18px;
    height: 18px;
    margin: 0;
    padding: 0 0 1px 0;
    border-width: 0;
    border-radius: 9px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--forge-text-dim);
    font-size: 14px;
    -unity-text-align: middle-center;
}

.forge-route__remove:hover {
    background-color: rgba(230, 90, 90, 0.18);
    color: var(--forge-lock);
}

.forge-route__remove:active {
    background-color: rgba(230, 90, 90, 0.32);
}

/* ── Modulation: source bar, drop targets, knob chips, amount bar ───── */

.forge-mod-bar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    flex-wrap: wrap;
    padding: 3px 6px;
    background-color: var(--forge-panel);
    border-bottom-width: 1px;
    border-bottom-color: var(--forge-border);
}

.forge-mod-bar__title {
    margin: 0 6px 0 2px;
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--forge-text-dim);
}

.forge-mod-bar__group {
    flex-direction: row;
    margin-right: 6px;
}

.forge-mod-bar__chip {
    flex-direction: row;
    align-items: center;
    height: 18px;
    padding: 0 7px 0 5px;
    margin: 1px 3px 1px 0;
    border-radius: 9px;
    background-color: var(--forge-panel-raised);
    cursor: move-arrow;
}

.forge-mod-bar__chip:hover {
    background-color: rgb(60, 63, 69);
}

.forge-mod-bar__dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
}

.forge-mod-bar__name {
    margin: 0 0 0 4px;
    padding: 0;
    font-size: 10px;
}

.forge-mod-bar__ghost {
    position: absolute;
    padding: 1px 6px;
    border-left-width: 3px;
    border-radius: 3px;
    background-color: rgb(20, 21, 24);
    font-size: 11px;
    -unity-font-style: bold;
}

.forge-mod-bar__ghost--refused {
    color: var(--forge-lock);
}

.forge-mod-dragging .forge-knob--mod-target > .forge-knob__dial {
    border-radius: 19px;
    background-color: rgba(255, 255, 255, 0.07);
}

.forge-mod-dragging .forge-knob--drop > .forge-knob__dial {
    background-color: rgba(120, 200, 255, 0.3);
}

.forge-mod-dragging .forge-knob--drop-refused > .forge-knob__dial {
    background-color: rgba(230, 90, 90, 0.3);
}

/* In the dial's open bottom gap, so a knob is the same size with or without routes. */
.forge-knob__mods {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    flex-direction: row;
    justify-content: center;
}

.forge-mod-chip {
    width: 7px;
    height: 7px;
    margin: 0 1px;
    border-width: 1px;
    border-radius: 1px;
    cursor: resize-vertical;
}

.forge-mod-chip--off {
    opacity: 0.35;
}

.forge-amount {
    height: 16px;
    border-radius: 2px;
    background-color: rgb(20, 21, 24);
    cursor: resize-horizontal;
}

.forge-amount__center {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    background-color: var(--forge-border);
}

.forge-amount__fill {
    position: absolute;
    top: 2px;
    bottom: 2px;
    opacity: 0.8;
}

.forge-amount__label {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    font-size: 10px;
    -unity-text-align: middle-center;
}

/* ── Help ─────────────────────────────────────────────────────────────── */

.forge-section-header {
    flex-direction: row;
    align-items: center;
}

.forge-layers-header {
    flex-shrink: 0;
    padding: 2px 6px 0 6px;
}

.forge-help-button {
    min-width: 18px;
    width: 18px;
    height: 18px;
    padding: 0;
    margin: 0 0 0 4px;
    border-radius: 9px;
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--forge-text-dim);
}

.forge-help-button:hover {
    color: var(--forge-accent);
}

.forge-help {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.forge-help__card {
    position: absolute;
    width: 360px;
    padding: 8px 10px 10px 10px;
    border-width: 1px;
    border-radius: 4px;
    border-color: var(--forge-accent);
    background-color: var(--forge-panel-raised);
}

.forge-help__header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 4px;
}

.forge-help__title {
    flex-grow: 1;
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--forge-accent);
}

.forge-help__close {
    width: 20px;
    min-width: 20px;
    height: 20px;
    padding: 0;
    margin: 0;
}

.forge-help__scroll {
    flex-shrink: 1;
}

.forge-help__summary {
    white-space: normal;
    margin-bottom: 8px;
}

.forge-help__item {
    flex-direction: row;
    margin-bottom: 4px;
}

.forge-help__name {
    width: 96px;
    flex-shrink: 0;
    white-space: normal;
    -unity-font-style: bold;
}

.forge-help__text {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    color: var(--forge-text-dim);
}
