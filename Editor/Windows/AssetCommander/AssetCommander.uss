/* Palette derives from Unity's theme variables so the window follows the editor skin.
   Nothing in this module hardcodes a Color in C#. */
:root {
    --dk-bg: var(--unity-colors-window-background, rgb(56, 56, 56));
    --dk-bg-panel: var(--unity-colors-default-background, rgb(64, 64, 64));
    --dk-bg-sunken: var(--unity-colors-app_toolbar-background, rgb(48, 48, 48));
    --dk-border: var(--unity-colors-default-border, rgb(35, 35, 35));
    --dk-text: var(--unity-colors-default-text, rgb(210, 210, 210));
    --dk-text-dim: var(--unity-colors-window-text, rgb(160, 160, 160));
    --dk-accent: var(--unity-colors-highlight-background, rgb(44, 93, 135));
    --dk-accent-idle: var(--unity-colors-highlight-background-inactive, rgb(77, 77, 77));
    --dk-warn-bg: var(--unity-colors-helpbox-background, rgb(70, 63, 45));
}

.ac-root {
    flex-grow: 1;
    background-color: var(--dk-bg);
}

.ac-flex-spacer {
    flex-grow: 1;
}

/* ── Window toolbar ─────────────────────────────────────────────────── */

.ac-toolbar {
    flex-shrink: 0;
}

.ac-index-status {
    -unity-text-align: middle-left;
    padding-left: 6px;
    color: var(--dk-text-dim);
    font-size: 11px;
}

.ac-index-progress {
    display: none;
    width: 160px;
    height: 14px;
    align-self: center;
    margin-left: 6px;
    margin-right: 6px;
}

.ac-index-progress.ac-index-progress--visible {
    display: flex;
}

.ac-index-progress .unity-progress-bar__title {
    display: none;
}

.ac-notice {
    display: none;
    flex-shrink: 0;
}

.ac-notice.ac-notice--visible {
    display: flex;
}

/* ── Split + sides ──────────────────────────────────────────────────── */

.ac-split {
    flex-grow: 1;
}

.ac-side {
    flex-grow: 1;
    min-width: 260px;
}

.ac-panel {
    flex-grow: 1;
    background-color: var(--dk-bg-panel);
    border-right-width: 1px;
    border-left-width: 1px;
    border-color: var(--dk-border);
}

.ac-panel.ac-panel--active {
    border-color: var(--dk-accent);
}

.ac-panel-toolbar {
    flex-shrink: 0;
}

.ac-side-label {
    width: 16px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: var(--dk-text-dim);
}

.ac-slot {
    flex-grow: 1;
    margin-right: 4px;
    min-width: 0;
}

.ac-slot > .unity-base-field__label {
    display: none;
}

/* ── Breadcrumb ─────────────────────────────────────────────────────── */

.ac-breadcrumb {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    padding: 3px 6px;
    background-color: var(--dk-bg-sunken);
    border-bottom-width: 1px;
    border-color: var(--dk-border);
}

.ac-crumb {
    font-size: 11px;
    color: var(--dk-text-dim);
}

.ac-crumb--last {
    color: var(--dk-text);
    -unity-font-style: bold;
}

.ac-crumb--link:hover {
    color: var(--dk-text);
    -unity-font-style: bold;
}

.ac-crumb-sep {
    font-size: 11px;
    color: var(--dk-text-dim);
    padding-left: 2px;
    padding-right: 2px;
}

/* ── Chips (modes + view toggle) ────────────────────────────────────── */

.ac-chips {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    padding: 4px 4px 2px 4px;
}

.ac-chip {
    font-size: 10px;
    height: 18px;
    margin: 0 3px 2px 0;
    padding: 0 8px;
    border-width: 0;
    border-radius: 9px;
    background-color: var(--dk-accent-idle);
    color: var(--dk-text-dim);
}

.ac-chip:hover:enabled {
    color: var(--dk-text);
}

.ac-chip--selected {
    background-color: var(--dk-accent);
    color: var(--dk-text);
    -unity-font-style: bold;
}

.ac-chip:disabled {
    opacity: 0.4;
}

/* ── View row ───────────────────────────────────────────────────────── */

.ac-view-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    border-bottom-width: 1px;
    border-color: var(--dk-border);
}

.ac-search {
    flex-grow: 1;
    margin: 2px 6px 4px 2px;
}

/* ── Content + status ───────────────────────────────────────────────── */

.ac-content {
    flex-grow: 1;
    background-color: var(--dk-bg);
}

.ac-view {
    flex-grow: 1;
}

.ac-hidden {
    display: none;
}

/* ── Rows ───────────────────────────────────────────────────────────── */

.ac-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    overflow: hidden;
}

.ac-row-icon {
    width: 16px;
    height: 16px;
    margin-right: 4px;
    flex-shrink: 0;
}

.ac-row-name {
    font-size: 11px;
    color: var(--dk-text);
    overflow: hidden;
    text-overflow: ellipsis;
}

.ac-row-sub {
    font-size: 10px;
    color: var(--dk-text-dim);
    margin-left: 6px;
    flex-shrink: 1;
    overflow: hidden;
}

.ac-row-badge {
    font-size: 9px;
    color: var(--dk-text-dim);
    background-color: var(--dk-accent-idle);
    border-radius: 2px;
    padding: 0 4px 0 4px;
    margin-left: auto;
    margin-right: 4px;
    flex-shrink: 0;
}

.ac-row-badge--alert {
    color: var(--dk-text);
    background-color: var(--dk-warn-bg);
}

.ac-row--dim .ac-row-name {
    color: var(--dk-text-dim);
    -unity-font-style: italic;
}

.ac-cell {
    font-size: 10px;
    color: var(--dk-text-dim);
    -unity-text-align: middle-left;
    overflow: hidden;
}

.ac-scene-notice {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 2px 4px 2px 6px;
    background-color: var(--dk-warn-bg);
    border-bottom-width: 1px;
    border-color: var(--dk-border);
}

.ac-scene-notice-text {
    font-size: 10px;
    color: var(--dk-text);
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.ac-placeholder {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.ac-placeholder-text {
    font-size: 11px;
    color: var(--dk-text-dim);
    -unity-text-align: middle-center;
    white-space: normal;
}

.ac-status {
    flex-shrink: 0;
    font-size: 10px;
    color: var(--dk-text-dim);
    padding: 2px 6px;
    background-color: var(--dk-bg-sunken);
    border-top-width: 1px;
    border-color: var(--dk-border);
}

/* ── Command bar ────────────────────────────────────────────────────── */

.ac-command-bar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 26px;
    padding: 0 6px;
    background-color: var(--dk-bg-sunken);
    border-top-width: 1px;
    border-color: var(--dk-border);
}

.ac-selection-status {
    font-size: 11px;
    color: var(--dk-text-dim);
}

.ac-command-buttons {
    flex-direction: row;
}
