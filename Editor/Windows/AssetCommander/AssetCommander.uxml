<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:VisualElement name="root" class="ac-root">
        <uie:Toolbar name="toolbar" class="ac-toolbar">
            <ui:Label name="index-status" class="ac-index-status" text="Index not built" />
            <ui:ProgressBar name="index-progress" class="ac-index-progress" low-value="0" high-value="100" />
            <ui:VisualElement class="ac-flex-spacer" />
            <uie:ToolbarButton name="rebuild-index" text="Rebuild Index" />
        </uie:Toolbar>
        <ui:VisualElement name="notice" class="ac-notice" />
        <ui:TwoPaneSplitView name="split" orientation="Horizontal" fixed-pane-index="0" fixed-pane-initial-dimension="450" class="ac-split">
            <ui:VisualElement name="side-a" class="ac-side" />
            <ui:VisualElement name="side-b" class="ac-side" />
        </ui:TwoPaneSplitView>
        <ui:VisualElement name="command-bar" class="ac-command-bar">
            <ui:Label name="selection-status" class="ac-selection-status" text="Nothing selected" />
            <ui:VisualElement class="ac-flex-spacer" />
            <ui:VisualElement name="command-buttons" class="ac-command-buttons" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
